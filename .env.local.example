# ---------------------------------------------------------------------------
# Decanted — Environment Variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# ── LLM Provider ───────────────────────────────────────────────────────────
# Setting this key switches the app from mock data to the live pipeline.
# Both extraction and enrichment run on Claude Haiku (claude-haiku-4-5).
ANTHROPIC_API_KEY=

# ── Supabase (catalog cache + scan cache + spend ledger) ────────────────────
# From your Supabase project settings. The SERVICE ROLE key is server-only —
# never expose it to the browser. If unset, the app runs the stateless pipeline
# (no caching, no budget cap).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cost controls ───────────────────────────────────────────────────────────
# Hard daily spend cap in CHF — the app refuses scans once today's estimated
# API spend reaches this. The primary abuse control (there is no login).
DAILY_BUDGET_CHF=3
# Per-IP daily scan cap (a speed bump on top of the budget cap).
RATE_LIMIT_PER_DAY=20

# ── Deployment ─────────────────────────────────────────────────────────────
# Your production URL — used for origin validation in middleware.
# Example: https://decanted.vercel.app
NEXT_PUBLIC_APP_URL=
